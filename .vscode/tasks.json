{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "G1BeamVariant",
      "type": "pickString",
      "description": "G1 depth policy variant",
      "options": ["V1", "V2", "V3", "V4"],
      "default": "V2"
    },
{
  "id": "G1TrainingTerrain",
  "type": "pickString",
  "description": "Training terrain level (half levels are midpoint widths): 0 = 0.60 m wide, 9 = 0.18 m wide; custom = 0.20 m wide; height above ground = 0.55 m",
  "options": [
    "scene_depth_training_level_0.xml",
    "scene_depth_training_level_0p5.xml",
    "scene_depth_training_level_1.xml",
    "scene_depth_training_level_1p5.xml",
    "scene_depth_training_level_2.xml",
    "scene_depth_training_level_2p5.xml",
    "scene_depth_training_level_3.xml",
    "scene_depth_training_level_3p5.xml",
    "scene_depth_training_level_4.xml",
    "scene_depth_training_level_4p5.xml",
    "scene_depth_training_level_5.xml",
    "scene_depth_training_level_5p5.xml",
    "scene_depth_training_level_6.xml",
    "scene_depth_training_level_6p5.xml",
    "scene_depth_training_level_7.xml",
    "scene_depth_training_level_7p5.xml",
    "scene_depth_training_level_8.xml",
    "scene_depth_training_level_8p5.xml",
    "scene_depth_training_level_9.xml",
    "scene_depth_training_width_20cm.xml"
  ],
  "default": "scene_depth_training_level_0.xml"
},
    {
      "id": "G1BeamRosDistro",
      "type": "pickString",
      "description": "G1 beam ROS distribution",
      "options": [
        "humble",
        "jazzy",
        "foxy",
        "galactic"
      ],
      "default": "humble"
    },
    {
      "id": "G1BeamNetworkInterface",
      "type": "promptString",
      "description": "G1 beam robot network interface (lo for local simulation)",
      "default": "eth0"
    },
    {
      "id": "RosDistro",
      "type": "pickString",
      "description": "Select ROS distribution",
      "options": ["jazzy", "humble", "foxy", "galactic"],
      "default": "humble"
    },
    {
      "id": "BuildType",
      "type": "pickString",
      "description": "Select build type",
      "options": ["Debug", "Release"],
      "default": "Release"
    },
    {
      "id": "NetworkInterface",
      "type": "pickString",
      "description": "Select network interface",
      "options": ["lo", "eth0", "enp130s0", "wlp129s0f0"],
      "default": "lo"
    },
    {
        "id": "Config Directory",
        "type": "promptString",
        "description": "Input config Directory",
        "default": ""
    },
    {
        "id": "Config Path",
        "type": "promptString",
        "description": "Input config path",
        "default": ""
    },
    {
        "id": "Python Version",
        "type": "promptString",
        "description": "Input Python version",
        "default": ""
    },
    {
        "id": "Pytorch Wheel URL",
        "type": "promptString",
        "description": "Input PyTorch wheel URL",
        "default": ""
    }
  ],
  "tasks": [
{
  "label": "G1 Beam Sim: Training Terrain",
  "type": "process",
  "command": "bash",
  "args": [
    "${workspaceFolder}/scripts/run.sh",
    "lo",
    "${input:G1BeamRosDistro}",
    "ros2",
    "run",
    "unitree_mujoco",
    "unitree_mujoco",
    "--config",
    "${workspaceFolder}/policies/g1/beam/g1_beam_depth_distillation/mujoco_training.yaml",
    "--scene",
    "${input:G1TrainingTerrain}",
    "--depth-camera"
  ],
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated"
  },
  "problemMatcher": []
},
{
  "label": "G1 Beam Sim: Training Terrain + Depth",
  "dependsOrder": "parallel",
  "dependsOn": [
    "G1 Beam Sim: Training Terrain",
    "G1 Beam Sim: Depth"
  ],
  "problemMatcher": []
},
{
  "label": "G1 Beam Sim: Mujoco",
  "type": "process",
  "command": "bash",
  "args": [
    "${workspaceFolder}/scripts/run.sh",
    "lo",
    "${input:G1BeamRosDistro}",
    "ros2",
    "run",
    "unitree_mujoco",
    "unitree_mujoco",
    "--config",
    "${workspaceFolder}/policies/g1/beam/g1_beam_depth_distillation/mujoco.yaml",
    "--depth-camera"
  ],
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated"
  },
  "problemMatcher": []
},
{
  "label": "G1 Beam Sim: Depth",
  "type": "process",
  "command": "bash",
  "args": [
    "${workspaceFolder}/scripts/run.sh",
    "lo",
    "${input:G1BeamRosDistro}",
    "ros2",
    "run",
    "legged_rl_deploy",
    "depth_image_preprocessor_node.py",
    "--ros-args",
    "--params-file",
    "${workspaceFolder}/policies/g1/beam/g1_beam_depth_distillation/depth_image_preprocessor_variants_sim.yaml"
  ],
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated"
  },
  "problemMatcher": []
},
{
  "label": "G1 Beam Sim: Mujoco + Depth",
  "dependsOrder": "parallel",
  "dependsOn": [
    "G1 Beam Sim: Mujoco",
    "G1 Beam Sim: Depth"
  ],
  "problemMatcher": []
},
{
  "label": "G1 Beam Sim: Policy",
  "type": "process",
  "command": "bash",
  "args": [
    "${workspaceFolder}/scripts/run.sh",
    "lo",
    "${input:G1BeamRosDistro}",
    "ros2",
    "run",
    "legged_rl_deploy",
    "legged_rl_deploy_node",
    "lo",
    "${workspaceFolder}/policies/g1/beam/g1_beam_depth_distillation/${input:G1BeamVariant}/config_sim.yaml"
  ],
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated"
  },
  "problemMatcher": []
},
{
  "label": "G1 Beam Sim: Check Depth Rate",
  "type": "process",
  "command": "bash",
  "args": [
    "${workspaceFolder}/scripts/run.sh",
    "lo",
    "${input:G1BeamRosDistro}",
    "ros2",
    "topic",
    "hz",
    "/g1_sim/beam_depth/normalized"
  ],
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated"
  },
  "problemMatcher": []
},
    {
      "label": "G1 Beam: Camera",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/run.sh",
        "${input:G1BeamNetworkInterface}",
        "${input:G1BeamRosDistro}",
        "ros2",
        "launch",
        "realsense2_camera",
        "rs_launch.py",
        "config_file:='${workspaceFolder}/policies/g1/beam/g1_beam_depth_distillation/D435i.yaml'"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "G1 Beam: Depth Preprocessor",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/run.sh",
        "${input:G1BeamNetworkInterface}",
        "${input:G1BeamRosDistro}",
        "ros2",
        "run",
        "legged_rl_deploy",
        "depth_image_preprocessor_node.py",
        "--ros-args",
        "--params-file",
        "${workspaceFolder}/policies/g1/beam/g1_beam_depth_distillation/depth_image_preprocessor.yaml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "G1 Beam: Camera + Depth",
      "dependsOrder": "parallel",
      "dependsOn": [
        "G1 Beam: Camera",
        "G1 Beam: Depth Preprocessor"
      ],
      "problemMatcher": []
    },
    {
      "label": "G1 Beam: Policy",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/run.sh",
        "${input:G1BeamNetworkInterface}",
        "${input:G1BeamRosDistro}",
        "ros2",
        "run",
        "legged_rl_deploy",
        "legged_rl_deploy_node",
        "${input:G1BeamNetworkInterface}",
        "${workspaceFolder}/policies/g1/beam/g1_beam_depth_distillation/config.yaml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "G1 Beam: Check Depth Rate",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/run.sh",
        "${input:G1BeamNetworkInterface}",
        "${input:G1BeamRosDistro}",
        "ros2",
        "topic",
        "hz",
        "/unitree_g1_beam_depth/depth_m"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Download ORT",
      "type": "shell",
      "command": "bash scripts/get_ort.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Convert pt to onnx",
      "type": "shell",
      "command": "${env:HOME}/.local/bin/uv",
      "args": [
          "run","python", "scripts/pt_to_onnx.py",
          "--pt", "${input:Config Directory}/policy.pt",
          "--onnx", "${input:Config Directory}/policy.onnx",
          "--config", "${input:Config Directory}/config.yaml"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Download Torch",
      "type": "shell",
      "command": "bash scripts/get_torch.sh ${input:Python Version} ${input:Pytorch Wheel URL}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/run.sh",
        "lo", "${input:RosDistro}",
        "colcon", "build", "--symlink-install", "--executor", "sequential",
        "--event-handlers", "console_direct+",
        "--packages-up-to", "legged_rl_deploy",
        "--cmake-args", "-DCMAKE_BUILD_TYPE=${input:BuildType}",
        "-DCMAKE_POSITION_INDEPENDENT_CODE=ON",
        "-DPython3_EXECUTABLE=/usr/bin/python3",
        "-DPython_EXECUTABLE=/usr/bin/python3",
        "-DPYTHON_EXECUTABLE=/usr/bin/python3"
      ],
      "group": "build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ROS2: Policies",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/run.sh",
        "${input:NetworkInterface}", "${input:RosDistro}",
        "ros2", "run", "legged_rl_deploy", "legged_rl_deploy_node",
        "${input:NetworkInterface}",
        "${workspaceFolder}/${input:Config Path}"
      ],
      "options": { 
        "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "ROS2: Depth",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/run.sh",
        "${input:NetworkInterface}", "${input:RosDistro}",
        "ros2", "run", "legged_rl_deploy", "depth_image_preprocessor_node.py",
        "--ros-args", "--params-file", "${workspaceFolder}/${input:Config Directory}/depth_image_preprocessor.yaml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "ROS2: Depth + Policies",
      "dependsOrder": "parallel",
      "dependsOn": [
        "ROS2: Depth",
        "ROS2: Policies"
      ],
      "problemMatcher": []
    }
  ]
}
